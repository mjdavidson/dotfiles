#!/bin/bash
# Get git status for tmux status bar
# Exec-minimal: one `git status` per run (plus git describe/rev-parse only on
# detached HEAD); all parsing is done with bash builtins. Works on bash 3.2+.

# Get the current pane's working directory from argument
pane_pwd="$1"
[[ -z "$pane_pwd" ]] && exit 0
cd "$pane_pwd" 2>/dev/null || exit 0

# One git call: fails outside a repo, otherwise gives branch header + file states
INDEX=$(git --no-optional-locks status --porcelain -b 2>/dev/null) || {
  # status failed: not a repo (silent exit) or an odd place like inside .git
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
  INDEX=''
}

GIT_ADDED=''
GIT_MODIFIED=''
GIT_UNTRACKED=''
GIT_RENAMED=''
GIT_DELETED='󰮉'
GIT_UNMERGED='󰧁'
GIT_AHEAD=''
GIT_BEHIND=''
GIT_DIVERGED='󰧈'
GIT_CLEAN=''

untracked=false staged=false modified=false renamed=false deleted=false
unmerged=false is_ahead=false is_behind=false
header=''

while IFS= read -r line; do
  case $line in
    '## '*)
      [[ -z $header ]] && header=$line
      [[ $line =~ ^##\ [^\ ]+\ .*ahead ]] && is_ahead=true
      [[ $line =~ ^##\ [^\ ]+\ .*behind ]] && is_behind=true
      continue ;;
  esac
  case $line in
    '?? '*) untracked=true ;;
  esac
  case $line in
    A[\ MDAU]\ *|M[\ MD]\ *|UA*) staged=true ;;
  esac
  case $line in
    [\ MARC]M\ *) modified=true ;;
  esac
  case $line in
    R[\ MD]\ *) renamed=true ;;
  esac
  case $line in
    [MARCDU\ ]D\ *|D[\ UM]\ *) deleted=true ;;
  esac
  case $line in
    U[UDA]\ *|AA\ *|DD\ *|[DA]U\ *) unmerged=true ;;
  esac
done <<<"$INDEX"

# Branch name from the "## " header: "main...origin/main [ahead 1]", "main",
# "No commits yet on main", "HEAD (no branch)"
branch=''
h=${header#\#\# }
case $h in
  'HEAD (no branch)') ;;
  '') ;;
  *) h=${h#No commits yet on }; h=${h#Initial commit on }
     branch=${h%%...*}; branch=${branch%% \[*} ;;
esac
if [[ -z $branch ]]; then
  # detached HEAD (or unparsable): tag name if exactly tagged, else short hash
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || git describe --tags --exact-match 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
fi

git_status=""
$untracked && git_status="${git_status}#[fg=#fab387,bold]${GIT_UNTRACKED} #[fg=default,nobold]"
$staged && git_status="${git_status}#[fg=#a6e3a1,bold]${GIT_ADDED} #[fg=default,nobold]"
$modified && git_status="${git_status}#[fg=#f9e2af,bold]${GIT_MODIFIED} #[fg=default,nobold]"
$renamed && git_status="${git_status}#[fg=#fab387,bold]${GIT_RENAMED} #[fg=default,nobold]"
$deleted && git_status="${git_status}#[fg=#f38ba8,bold]${GIT_DELETED} #[fg=default,nobold]"
# (original stash check never fired -- its $(...) was always empty -- so it is dropped)
$unmerged && git_status="${git_status}#[fg=#f38ba8,bold]${GIT_UNMERGED} #[fg=default,nobold]"

if $is_ahead && $is_behind; then
  git_status="${git_status}#[fg=#89b4fa,bold]${GIT_DIVERGED} #[fg=default,nobold]"
else
  $is_ahead && git_status="${git_status}#[fg=#89b4fa,bold]${GIT_AHEAD} #[fg=default,nobold]"
  $is_behind && git_status="${git_status}#[fg=#89dceb,bold]${GIT_BEHIND} #[fg=default,nobold]"
fi

# If no status, show clean
[[ -z "$git_status" ]] && git_status="#[fg=#a6e3a1,bold]${GIT_CLEAN} #[fg=default,nobold]"

echo " $branch $git_status"
